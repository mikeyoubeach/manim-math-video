{
  "total_duration": 40.58,
  "voice": "冰糖",
  "segments": [
    {
      "index": 0,
      "text": "来看第九题，复数运算。",
      "file": "seg_001.wav",
      "start": 0.0,
      "end": 2.4,
      "duration": 2.4
    },
    {
      "index": 1,
      "text": "z等于1加i。",
      "file": "seg_002.wav",
      "start": 2.9,
      "end": 4.82,
      "duration": 1.92
    },
    {
      "index": 2,
      "text": "求z的平方减2z的模。",
      "file": "seg_003.wav",
      "start": 5.32,
      "end": 7.88,
      "duration": 2.56
    },
    {
      "index": 3,
      "text": "这道题直接算就行。",
      "file": "seg_004.wav",
      "start": 8.38,
      "end": 10.14,
      "duration": 1.76
    },
    {
      "index": 4,
      "text": "先算z的平方。",
      "file": "seg_005.wav",
      "start": 10.64,
      "end": 12.24,
      "duration": 1.6
    },
    {
      "index": 5,
      "text": "1加i的平方，等于1加2i加i的平方。",
      "file": "seg_006.wav",
      "start": 12.74,
      "end": 16.42,
      "duration": 3.68
    },
    {
      "index": 6,
      "text": "i的平方等于负1。",
      "file": "seg_007.wav",
      "start": 16.92,
      "end": 18.84,
      "duration": 1.92
    },
    {
      "index": 7,
      "text": "所以z的平方等于2i。",
      "file": "seg_008.wav",
      "start": 19.34,
      "end": 21.58,
      "duration": 2.24
    },
    {
      "index": 8,
      "text": "再算2z，等于2加2i。",
      "file": "seg_009.wav",
      "start": 22.08,
      "end": 24.8,
      "duration": 2.72
    },
    {
      "index": 9,
      "text": "z的平方减2z，等于2i减2减2i，等于负2。",
      "file": "seg_010.wav",
      "start": 25.3,
      "end": 30.42,
      "duration": 5.12
    },
    {
      "index": 10,
      "text": "负2的模就是2。",
      "file": "seg_011.wav",
      "start": 30.92,
      "end": 32.68,
      "duration": 1.76
    },
    {
      "index": 11,
      "text": "答案选D。",
      "file": "seg_012.wav",
      "start": 33.18,
      "end": 34.3,
      "duration": 1.12
    },
    {
      "index": 12,
      "text": "复数运算别慌，一步步来，先算平方再算乘法最后相减。",
      "file": "seg_013.wav",
      "start": 34.8,
      "end": 40.08,
      "duration": 5.28
    }
  ]
}