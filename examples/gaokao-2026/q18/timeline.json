{
  "total_duration": 103.38,
  "voice": "冰糖",
  "segments": [
    {
      "index": 0,
      "text": "来看第十八题，椭圆。",
      "file": "seg_001.wav",
      "start": 0.0,
      "end": 1.92,
      "duration": 1.92
    },
    {
      "index": 1,
      "text": "椭圆C的方程是x²除以a²加y²除以b²等于1，a大于b大于0。",
      "file": "seg_002.wav",
      "start": 2.42,
      "end": 8.34,
      "duration": 5.92
    },
    {
      "index": 2,
      "text": "左焦点F坐标负1逗号0，离心率等于2分之1。",
      "file": "seg_003.wav",
      "start": 8.84,
      "end": 13.32,
      "duration": 4.48
    },
    {
      "index": 3,
      "text": "第一问，求椭圆方程。",
      "file": "seg_004.wav",
      "start": 13.82,
      "end": 15.9,
      "duration": 2.08
    },
    {
      "index": 4,
      "text": "左焦点等于负c，所以c等于1。",
      "file": "seg_005.wav",
      "start": 16.4,
      "end": 19.44,
      "duration": 3.04
    },
    {
      "index": 5,
      "text": "离心率e等于c除以a等于2分之1，所以a等于2。",
      "file": "seg_006.wav",
      "start": 19.94,
      "end": 25.06,
      "duration": 5.12
    },
    {
      "index": 6,
      "text": "b²等于a²减c²等于4减1等于3。",
      "file": "seg_007.wav",
      "start": 25.56,
      "end": 29.24,
      "duration": 3.68
    },
    {
      "index": 7,
      "text": "椭圆方程是x²除以4加y²除以3等于1。",
      "file": "seg_008.wav",
      "start": 29.74,
      "end": 33.74,
      "duration": 4.0
    },
    {
      "index": 8,
      "text": "第二问第一小题。",
      "file": "seg_009.wav",
      "start": 34.24,
      "end": 36.0,
      "duration": 1.76
    },
    {
      "index": 9,
      "text": "过F且斜率大于0的动直线l与椭圆交于P和Q两点。",
      "file": "seg_010.wav",
      "start": 36.5,
      "end": 41.62,
      "duration": 5.12
    },
    {
      "index": 10,
      "text": "Q在第三象限。",
      "file": "seg_011.wav",
      "start": 42.12,
      "end": 43.72,
      "duration": 1.6
    },
    {
      "index": 11,
      "text": "直线PO与椭圆另一个交点为R。",
      "file": "seg_012.wav",
      "start": 44.22,
      "end": 47.42,
      "duration": 3.2
    },
    {
      "index": 12,
      "text": "若三角形PQR的面积是三角形PFO面积的3倍，求l的方程。",
      "file": "seg_013.wav",
      "start": 47.92,
      "end": 54.32,
      "duration": 6.4
    },
    {
      "index": 13,
      "text": "设直线l的斜率为k，方程为y等于k乘以x加1。",
      "file": "seg_014.wav",
      "start": 54.82,
      "end": 59.78,
      "duration": 4.96
    },
    {
      "index": 14,
      "text": "代入椭圆方程，用韦达定理求出P和Q的坐标关系。",
      "file": "seg_015.wav",
      "start": 60.28,
      "end": 64.76,
      "duration": 4.48
    },
    {
      "index": 15,
      "text": "由面积条件，可以得到关于k的方程。",
      "file": "seg_016.wav",
      "start": 65.26,
      "end": 67.98,
      "duration": 2.72
    },
    {
      "index": 16,
      "text": "解出k等于1。",
      "file": "seg_017.wav",
      "start": 68.48,
      "end": 70.08,
      "duration": 1.6
    },
    {
      "index": 17,
      "text": "所以直线l的方程是y等于x加1。",
      "file": "seg_018.wav",
      "start": 70.58,
      "end": 74.58,
      "duration": 4.0
    },
    {
      "index": 18,
      "text": "第二小题，求tan角PQR的最小值。",
      "file": "seg_019.wav",
      "start": 75.08,
      "end": 78.76,
      "duration": 3.68
    },
    {
      "index": 19,
      "text": "用向量法或斜率公式。",
      "file": "seg_020.wav",
      "start": 79.26,
      "end": 81.34,
      "duration": 2.08
    },
    {
      "index": 20,
      "text": "设P和Q的坐标，用参数t表示。",
      "file": "seg_021.wav",
      "start": 81.84,
      "end": 84.88,
      "duration": 3.04
    },
    {
      "index": 21,
      "text": "tan角PQR等于斜率之差的绝对值除以1加斜率之积。",
      "file": "seg_022.wav",
      "start": 85.38,
      "end": 90.98,
      "duration": 5.6
    },
    {
      "index": 22,
      "text": "用韦达定理化简，得到关于k的表达式。",
      "file": "seg_023.wav",
      "start": 91.48,
      "end": 94.68,
      "duration": 3.2
    },
    {
      "index": 23,
      "text": "求导或用均值不等式求最小值。",
      "file": "seg_024.wav",
      "start": 95.18,
      "end": 98.22,
      "duration": 3.04
    },
    {
      "index": 24,
      "text": "最终tan角PQR的最小值等于3分之根号3。",
      "file": "seg_025.wav",
      "start": 98.72,
      "end": 102.88,
      "duration": 4.16
    }
  ]
}