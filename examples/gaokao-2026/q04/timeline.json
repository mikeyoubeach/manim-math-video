{
  "total_duration": 51.0,
  "voice": "冰糖",
  "segments": [
    {
      "index": 0,
      "text": "我们来看第4题。",
      "file": "seg_001.wav",
      "start": 0.0,
      "end": 1.6,
      "duration": 1.6
    },
    {
      "index": 1,
      "text": "曲线y等于5x加8倍的lnx，在点1逗号5处的切线方程。",
      "file": "seg_002.wav",
      "start": 2.1,
      "end": 8.34,
      "duration": 6.24
    },
    {
      "index": 2,
      "text": "首先，画出这条曲线。",
      "file": "seg_003.wav",
      "start": 8.84,
      "end": 11.08,
      "duration": 2.24
    },
    {
      "index": 3,
      "text": "这是一个对数函数和一次函数的叠加。",
      "file": "seg_004.wav",
      "start": 11.58,
      "end": 14.46,
      "duration": 2.88
    },
    {
      "index": 4,
      "text": "注意观察，当x趋向零时，lnx趋向负无穷。",
      "file": "seg_005.wav",
      "start": 14.96,
      "end": 19.6,
      "duration": 4.64
    },
    {
      "index": 5,
      "text": "当x增大，5x占主导，曲线近似一条直线。",
      "file": "seg_006.wav",
      "start": 20.1,
      "end": 24.58,
      "duration": 4.48
    },
    {
      "index": 6,
      "text": "我们要找的，是在x等于1这个点的切线。",
      "file": "seg_007.wav",
      "start": 25.08,
      "end": 28.28,
      "duration": 3.2
    },
    {
      "index": 7,
      "text": "切线的斜率，等于导数。",
      "file": "seg_008.wav",
      "start": 28.78,
      "end": 31.02,
      "duration": 2.24
    },
    {
      "index": 8,
      "text": "对y求导，y撇等于5加x分之8。",
      "file": "seg_009.wav",
      "start": 31.52,
      "end": 34.88,
      "duration": 3.36
    },
    {
      "index": 9,
      "text": "把x等于1代入，斜率k等于13。",
      "file": "seg_010.wav",
      "start": 35.38,
      "end": 38.42,
      "duration": 3.04
    },
    {
      "index": 10,
      "text": "现在画出切线。",
      "file": "seg_011.wav",
      "start": 38.92,
      "end": 40.36,
      "duration": 1.44
    },
    {
      "index": 11,
      "text": "用点斜式，y减5等于13乘以x减1。",
      "file": "seg_012.wav",
      "start": 40.86,
      "end": 45.02,
      "duration": 4.16
    },
    {
      "index": 12,
      "text": "展开化简，y等于13x减8。",
      "file": "seg_013.wav",
      "start": 45.52,
      "end": 48.4,
      "duration": 2.88
    },
    {
      "index": 13,
      "text": "所以答案是D。",
      "file": "seg_014.wav",
      "start": 48.9,
      "end": 50.5,
      "duration": 1.6
    }
  ]
}