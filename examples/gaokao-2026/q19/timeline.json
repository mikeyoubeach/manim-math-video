{
  "total_duration": 251.38,
  "voice": "冰糖",
  "segments": [
    {
      "index": 0,
      "text": "来看第十九题，函数性质证明。",
      "file": "seg_001.wav",
      "start": 0.0,
      "end": 2.88,
      "duration": 2.88
    },
    {
      "index": 1,
      "text": "函数f(x)的定义域是全体实数。",
      "file": "seg_002.wav",
      "start": 3.38,
      "end": 6.74,
      "duration": 3.36
    },
    {
      "index": 2,
      "text": "当x小于0时，f(x)等于2的x次方。",
      "file": "seg_003.wav",
      "start": 7.24,
      "end": 12.04,
      "duration": 4.8
    },
    {
      "index": 3,
      "text": "对任意x0，定义集合D(x0)等于所有使得f(x0加d)大于f(x0)的d。",
      "file": "seg_004.wav",
      "start": 12.54,
      "end": 21.18,
      "duration": 8.64
    },
    {
      "index": 4,
      "text": "第一问，当x大于等于0时，f(x)等于1减x，求D(负1)。",
      "file": "seg_005.wav",
      "start": 21.68,
      "end": 27.12,
      "duration": 5.44
    },
    {
      "index": 5,
      "text": "f(负1)等于2的负1次方等于2分之1。",
      "file": "seg_006.wav",
      "start": 27.62,
      "end": 31.3,
      "duration": 3.68
    },
    {
      "index": 6,
      "text": "需要找所有d使得f(负1加d)大于2分之1。",
      "file": "seg_007.wav",
      "start": 31.8,
      "end": 36.28,
      "duration": 4.48
    },
    {
      "index": 7,
      "text": "当负1加d小于0时，f等于2的负1加d次方。",
      "file": "seg_008.wav",
      "start": 36.78,
      "end": 41.26,
      "duration": 4.48
    },
    {
      "index": 8,
      "text": "要求2的负1加d次方大于2分之1，即负1加d大于负1，d大于0。",
      "file": "seg_009.wav",
      "start": 41.76,
      "end": 48.8,
      "duration": 7.04
    },
    {
      "index": 9,
      "text": "当负1加d大于等于0时，f等于1减负1加d等于2减d。",
      "file": "seg_010.wav",
      "start": 49.3,
      "end": 54.58,
      "duration": 5.28
    },
    {
      "index": 10,
      "text": "要求2减d大于2分之1，d小于2分之3。",
      "file": "seg_011.wav",
      "start": 55.08,
      "end": 59.72,
      "duration": 4.64
    },
    {
      "index": 11,
      "text": "所以D(负1)等于开区间0到2分之3。",
      "file": "seg_012.wav",
      "start": 60.22,
      "end": 64.7,
      "duration": 4.48
    },
    {
      "index": 12,
      "text": "第二问，f是奇函数，f(x1)小于等于f(x2)，x1x2不等于0。",
      "file": "seg_013.wav",
      "start": 65.2,
      "end": 72.56,
      "duration": 7.36
    },
    {
      "index": 13,
      "text": "证明D(x2)包含于D(x1)。",
      "file": "seg_014.wav",
      "start": 73.06,
      "end": 76.26,
      "duration": 3.2
    },
    {
      "index": 14,
      "text": "因为f是奇函数，f(负x)等于负f(x)。",
      "file": "seg_015.wav",
      "start": 76.76,
      "end": 81.08,
      "duration": 4.32
    },
    {
      "index": 15,
      "text": "由f(x1)小于等于f(x2)，得负f(x1)大于等于负f(x2)。",
      "file": "seg_016.wav",
      "start": 81.58,
      "end": 88.78,
      "duration": 7.2
    },
    {
      "index": 16,
      "text": "即f(负x1)大于等于f(负x2)。",
      "file": "seg_017.wav",
      "start": 89.28,
      "end": 94.24,
      "duration": 4.96
    },
    {
      "index": 17,
      "text": "如果d属于D(x2)，则f(x2加d)大于f(x2)。",
      "file": "seg_018.wav",
      "start": 94.74,
      "end": 101.62,
      "duration": 6.88
    },
    {
      "index": 18,
      "text": "因为f(x2)大于等于f(x1)，所以f(x2加d)大于f(x1)。",
      "file": "seg_019.wav",
      "start": 102.12,
      "end": 109.96,
      "duration": 7.84
    },
    {
      "index": 19,
      "text": "又因为f是奇函数，f(x1)小于等于f(x2)，可以推出f(x1加d)大于f(x1)。",
      "file": "seg_020.wav",
      "start": 110.46,
      "end": 118.94,
      "duration": 8.48
    },
    {
      "index": 20,
      "text": "所以d属于D(x1)。",
      "file": "seg_021.wav",
      "start": 119.44,
      "end": 121.52,
      "duration": 2.08
    },
    {
      "index": 21,
      "text": "第三问，条件：若f(x1)小于等于f(x2)，则D(x2)包含于D(x1)。",
      "file": "seg_022.wav",
      "start": 122.02,
      "end": 130.34,
      "duration": 8.32
    },
    {
      "index": 22,
      "text": "当0小于x小于1时，f(x)小于f(0)。",
      "file": "seg_023.wav",
      "start": 130.84,
      "end": 134.68,
      "duration": 3.84
    },
    {
      "index": 23,
      "text": "证明f(0)大于等于1。",
      "file": "seg_024.wav",
      "start": 135.18,
      "end": 137.74,
      "duration": 2.56
    },
    {
      "index": 24,
      "text": "反证法：假设f(0)小于1。",
      "file": "seg_025.wav",
      "start": 138.24,
      "end": 141.12,
      "duration": 2.88
    },
    {
      "index": 25,
      "text": "由条件②，取0小于x小于1，f(x)小于f(0)小于1。",
      "file": "seg_026.wav",
      "start": 141.62,
      "end": 146.74,
      "duration": 5.12
    },
    {
      "index": 26,
      "text": "由f(x)小于f(0)，得D(0)包含于D(x)。",
      "file": "seg_027.wav",
      "start": 147.24,
      "end": 152.2,
      "duration": 4.96
    },
    {
      "index": 27,
      "text": "取d等于负x，f(0)大于f(x)，所以d等于负x属于D(x)。",
      "file": "seg_028.wav",
      "start": 152.7,
      "end": 159.26,
      "duration": 6.56
    },
    {
      "index": 28,
      "text": "由D(0)包含于D(x)，得负x属于D(0)。",
      "file": "seg_029.wav",
      "start": 159.76,
      "end": 164.56,
      "duration": 4.8
    },
    {
      "index": 29,
      "text": "即f(0加负x)大于f(0)，f(负x)大于f(0)。",
      "file": "seg_030.wav",
      "start": 165.06,
      "end": 171.46,
      "duration": 6.4
    },
    {
      "index": 30,
      "text": "当x大于0时，负x小于0，f(负x)等于2的负x次方。",
      "file": "seg_031.wav",
      "start": 171.96,
      "end": 177.72,
      "duration": 5.76
    },
    {
      "index": 31,
      "text": "所以2的负x次方大于f(0)。",
      "file": "seg_032.wav",
      "start": 178.22,
      "end": 181.1,
      "duration": 2.88
    },
    {
      "index": 32,
      "text": "当x趋向0正时，2的负x次方趋向1。",
      "file": "seg_033.wav",
      "start": 181.6,
      "end": 185.92,
      "duration": 4.32
    },
    {
      "index": 33,
      "text": "所以f(0)小于等于1。",
      "file": "seg_034.wav",
      "start": 186.42,
      "end": 189.3,
      "duration": 2.88
    },
    {
      "index": 34,
      "text": "再由f(x)小于f(0)和条件①，可以推出矛盾。",
      "file": "seg_035.wav",
      "start": 189.8,
      "end": 193.96,
      "duration": 4.16
    },
    {
      "index": 35,
      "text": "最终f(0)大于等于1。",
      "file": "seg_036.wav",
      "start": 194.46,
      "end": 197.02,
      "duration": 2.56
    },
    {
      "index": 36,
      "text": "第四问，证明f(x)在0到正无穷单调递增。",
      "file": "seg_037.wav",
      "start": 197.52,
      "end": 201.84,
      "duration": 4.32
    },
    {
      "index": 37,
      "text": "用条件①和②，结合f(0)大于等于1。",
      "file": "seg_038.wav",
      "start": 202.34,
      "end": 205.86,
      "duration": 3.52
    },
    {
      "index": 38,
      "text": "设0小于x1小于x2。",
      "file": "seg_039.wav",
      "start": 206.36,
      "end": 209.08,
      "duration": 2.72
    },
    {
      "index": 39,
      "text": "需要证明f(x1)小于f(x2)。",
      "file": "seg_040.wav",
      "start": 209.58,
      "end": 213.9,
      "duration": 4.32
    },
    {
      "index": 40,
      "text": "反证法：假设f(x1)大于f(x2)。",
      "file": "seg_041.wav",
      "start": 214.4,
      "end": 218.72,
      "duration": 4.32
    },
    {
      "index": 41,
      "text": "由条件①，D(x2)包含于D(x1)。",
      "file": "seg_042.wav",
      "start": 219.22,
      "end": 223.22,
      "duration": 4.0
    },
    {
      "index": 42,
      "text": "取d等于x2减x1大于0。",
      "file": "seg_043.wav",
      "start": 223.72,
      "end": 226.44,
      "duration": 2.72
    },
    {
      "index": 43,
      "text": "f(x1加d)等于f(x2)，不大于f(x1)。",
      "file": "seg_044.wav",
      "start": 226.94,
      "end": 231.9,
      "duration": 4.96
    },
    {
      "index": 44,
      "text": "所以d不属于D(x1)。",
      "file": "seg_045.wav",
      "start": 232.4,
      "end": 234.48,
      "duration": 2.08
    },
    {
      "index": 45,
      "text": "但f(x2加d)等于f(x2加x2减x1)。",
      "file": "seg_046.wav",
      "start": 234.98,
      "end": 239.78,
      "duration": 4.8
    },
    {
      "index": 46,
      "text": "需要证明这大于f(x2)。",
      "file": "seg_047.wav",
      "start": 240.28,
      "end": 242.68,
      "duration": 2.4
    },
    {
      "index": 47,
      "text": "由f(0)大于等于1和条件②，可以推出矛盾。",
      "file": "seg_048.wav",
      "start": 243.18,
      "end": 247.18,
      "duration": 4.0
    },
    {
      "index": 48,
      "text": "最终f在0到正无穷单调递增。",
      "file": "seg_049.wav",
      "start": 247.68,
      "end": 250.88,
      "duration": 3.2
    }
  ]
}